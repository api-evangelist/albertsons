              "raw": "{\n  \"startDate\": \"<date>\",\n  \"endDate\": \"<date>\",\n  \"campaignIds\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"dimensions\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"metrics\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"format\": \"json\"\n}",
